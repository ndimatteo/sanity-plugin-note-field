{
  "name": "sanity-plugin-note-field",
  "version": "2.0.2",
  "description": "Display inline notes within your schemas",
  "keywords": [
    "sanity",
    "sanity-plugin",
    "note",
    "input",
    "custom field"
  ],
  "homepage": "https://github.com/ndimatteo/sanity-plugin-note-field#readme",
  "bugs": {
    "url": "https://github.com/ndimatteo/sanity-plugin-note-field/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ndimatteo/sanity-plugin-note-field.git"
  },
  "license": "MIT",
  "author": "Nick DiMatteo <hello@nickdimatteo.com>",
  "sideEffects": false,
  "type": "module",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "sanity.json",
    "src",
    "v2-incompatible.js"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "verify": "pkg-utils build --strict --check && plugin-kit verify-package --silent",
    "watch": "pkg-utils watch --strict",
    "link-watch": "plugin-kit link-watch",
    "prepublishOnly": "npm run build && npm run verify",
    "format": "prettier --write --cache --ignore-unknown .",
    "lint": "eslint ."
  },
  "dependencies": {
    "@sanity/incompatible-plugin": "^1.0.5",
    "@sanity/ui": "^3.1.11",
    "lodash": "^4.17.21",
    "prop-types": "^15.7.2"
  },
  "devDependencies": {
    "@sanity/pkg-utils": "^10.3.2",
    "@sanity/plugin-kit": "^4.0.20",
    "@types/lodash": "^4.17.23",
    "@types/react": "^19.2.8",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-sanity": "^7.1.4",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.0",
    "prettier-plugin-packagejson": "^2.5.21",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-is": "^19.2.3",
    "rimraf": "^6.1.2",
    "sanity": "^5.4.0",
    "styled-components": "^6.3.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^18",
    "sanity": "^3"
  },
  "engines": {
    "node": ">=18"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "sanityPlugin": {
    "linkWatch": {
      "command": "npm run watch",
      "extensions": "ts,tsx"
    }
  },
  "pkg-utils": {
    "targets": {
      "node": {
        "runtime": "node"
      }
    }
  }
}
